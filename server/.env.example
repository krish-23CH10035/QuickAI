# ============================================
# REQUIRED Environment Variables for Railway
# ============================================

# Database (Neon PostgreSQL)
# Get this from: https://neon.tech/ (Create a new database)
DATABASE_URL=postgresql://username:password@host.neon.tech/database?sslmode=require

# AI/ML APIs
# Get this from: https://console.groq.com/keys (Free API key)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cloudinary (Image Storage)
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ClickDrop API (Background Removal)
# Get this from: https://www.clickdrop.ai/ or your provider
CLICKDROP_API_KEY=your_clickdrop_api_key

# Clerk Authentication
# Get these from: https://dashboard.clerk.com/
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# You can also use CLERK_API_KEY or CLERK_FRONTEND_API as alternatives

# ============================================
# OPTIONAL Environment Variables
# ============================================

# Client Origin (Frontend URL)
# Use your deployed frontend URL or local development URL
CLIENT_ORIGIN=https://your-frontend-app.vercel.app

# Port (Automatically set by Railway, no need to configure)
# PORT=3000
